# === REQUIRED — system will not start without these ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here
VOYAGE_API_KEY=your_voyage_api_key_here
DATABASE_URL=postgresql://user:password@localhost:5432/gigai

# === Google Cloud ===
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
PUBSUB_TOPIC_RAW_EVENTS=raw-events
PUBSUB_TOPIC_NORMALIZED_EVENTS=normalized-events
PUBSUB_TOPIC_ENRICHED_EVENTS=enriched-events
PUBSUB_TOPIC_SIGNALS=signals

# === Autodesk Construction Cloud ===
# OAuth2 2-legged credentials from https://aps.autodesk.com/myapps
ACC_CLIENT_ID=your_acc_client_id
ACC_CLIENT_SECRET=your_acc_client_secret
# Hub / Account ID (starts with "b.") — found in ACC Admin > Account Info
ACC_ACCOUNT_ID=b.your_account_id
# Project ID for the active construction project
ACC_PROJECT_ID=b.your_project_id
# Issues container ID — obtained from GET /issues/v1/containers (project-level)
ACC_ISSUES_CONTAINER_ID=your_issues_container_id

# === Gmail / Google Calendar ===
# OAuth2 credentials from Google Cloud Console (Desktop or Web app type)
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token
# Calendar to create events in (use "primary" for the authenticated user's main calendar)
GOOGLE_CALENDAR_ID=primary

# === External Service Keys ===
FIREFLIES_API_KEY=your_fireflies_api_key

# === FastAPI ===
# Optional: set to require X-API-Key header on all API endpoints
API_KEY=your_api_key_here
